/* Leading multi-line
   block comment for cJSON_Minify */
// Leading single-line comment

		   
{   // Object start comment
	/* Key 1 */
	"url"   	:   	"https://example.com/a//b/*not_a_comment*/"   ,   /* preserve // and /* inside strings */
	
	
	"spaces_in_str"		:		"   \t\n  /* keep spaces */  // keep   "   ,
	
	/* Nested array with heavy whitespace and comments */
	"items"   :   [
		1   ,   /* one */
		2   ,   // two
		3   ,   /* three */
		"/* fake comment */"   ,   // string with block comment syntax
		"// another fake"   ,
		true   ,
		false   ,
		null
	]   ,   // end items
	
	"nested"   :   {   /* inner object */
		"a"   :   123   ,
		"b"   :   -45.67e+8   ,   /* float */
		"c"   :   "escaped \" // /* quote"   // escaped quote before comment-like text
	}   /* end inner object */
	
}   // Trailing single-line comment
/* Trailing block comment */

		   
